# ─────────────────────────────────────────────
# Kilimo Trust Server — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────

# ── Server ──────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Neo4j AuraDB ────────────────────────────
# Get these from https://console.neo4j.io
NEO4J_URI=bolt://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-secure-password

# ── Featherless AI ──────────────────────────
# OCR, NLP, TTS pipeline
# Get your key from https://featherless.ai
FEATHERLESS_API_KEY=your-featherless-api-key
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# ── Masumi Agent ────────────────────────────
# Orchestration & escalation agent
MASUMI_API_KEY=your-masumi-api-key
MASUMI_ENDPOINT=https://api.masumi.network/v1

# ── File Storage ────────────────────────────
# For uploaded label images (local dev uses /uploads)
UPLOAD_DIR=./uploads
AUDIO_DIR=./public/audio

# ── Offline Sync ────────────────────────────
# Interval (ms) at which the sync job re-checks the outbox queue
SYNC_INTERVAL_MS=30000

# ── Security ────────────────────────────────
# JWT secret for the Expert Dashboard sessions
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=8h

# ── CORS ────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-lovable-app.lovable.app
